{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servienta-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "servienta-admin",
      "database_id": "72cd5fe3-7383-4e1a-9323-9135c2714a30",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RESEND_FROM": "Servienta <onboarding@resend.dev>",
    "LICENSE_PUBLIC_KEY": "MCowBQYDK2VwAyEAOi42TytGwPNapeKWDHyVBKsINgQdWa8dAPmEXHJnAvE="
  },
  "routes": [{ "pattern": "admin.servienta.com", "custom_domain": true }]
}
